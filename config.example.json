{
  // === 图库根目录 ==========================================
  // 网页里「设置 -> 更改图库目录」选完会自动写这里
  // 留空 = 启动后在网页里选；填绝对路径会直接用它
  "root": "",

  // ui = 界面与浏览的默认设置，网页里「保存设置」会写回这里
  "ui": {
    // 默认视图：grid = 网格 / two = 多列 / single = 单列长条
    "view": "grid",
    // 网格列数：1 - 8
    "cols": 4,
    // 图片间距（px）：0 - 24
    "gap": 4,
    // 图片填充：auto = 原图比例 / cover = 裁剪填满 / contain = 完整显示 / fill = 拉伸铺满
    "fit": "auto",
    // 主题：light = 浅色 / dark = 深色
    "theme": "light",
    // 初始旋转角度：0 / 90 / 180 / 270
    "rot": 0,
    // 自动滚动速度（px/s）：10 - 400，仅连续滚动时生效
    "autoSpeed": 90,
    // 自动滚动方式：scroll = 连续匀速下滑 / step = 每隔 N 秒翻一屏
    "autoMode": "scroll",
    // 自动滚动间隔（秒）：1 - 60，仅 step 模式生效
    "autoStep": 6,
    // 幻灯片间隔（秒）：1 - 30
    "slideSec": 6,
    // 播完一整册后：loop = 循环本册 / next = 自动跳下一个相册
    "playMode": "loop",
    // 多列模式图片缩放（%）：100 = 填满一列，<100 变小留白，>100 放大裁边
    "twoH": 100,
    // 多列模式列数：2 - 6
    "twoCols": 2,
    // 是否默认「读取所有子文件夹」
    "recursive": false,
    // 是否在图片上显示序号：true = 显示，false = 不显示
    "showIndex": false,
    // 排序字段（目前只支持 name）
    "sort": "name"
  }
}
